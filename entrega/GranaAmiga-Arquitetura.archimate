  <folder name="Application" id="id-6f06e33234ea4768a5a75981441647e5" type="application">
    <element xsi:type="archimate:ApplicationService" name="SERV: Registro de gasto por mensagem" id="id-feadd901f6e1471cafeb5cac6a231d4a">
      <documentation>Transcreve o áudio e grava a transação com origem = WHATSAPP.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="SERV: Autenticação e conta" id="id-d82790c630024e18aec8acc34a5ca538"/>
    <element xsi:type="archimate:ApplicationService" name="SERV: Transações e categorias" id="id-52c7f3598e6e4bedbe01fe4fb86472b7">
      <documentation>Extrato do mês, filtro dinâmico, resumo por categoria.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="SERV: Dívidas, plano e alertas" id="id-e9bbcfe43e3449fba0a757751852a037">
      <documentation>CRUD de dívidas, plano de quitação, alertas de vencimento e termômetro de dívidas.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="SERV: Conteúdo educativo (trilhas e desafios)" id="id-ffc2a4b0b3474888a3400729484086d4"/>
    <element xsi:type="archimate:ApplicationService" name="SERV: Termômetros do dinheiro e das dívidas" id="id-44cfe77f68ed4e17ad07162e34838a00">
      <documentation>Termômetro do Dinheiro (gastos ÷ entradas, &lt;70% / &lt;90%): painel do app e PL/SQL. Termômetro de dívidas (parcelas ÷ renda, ≤30% / ≤50%): GET /api/v1/dividas/termometro.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="SERV: Leituras e alertas de energia" id="id-464d2085b50c486689325be4294b52b5"/>
    <element xsi:type="archimate:ApplicationComponent" name="COMP: App Mobile Grana Amiga (Flutter)" id="id-7b9520475c644cc586e049e8e7dd96da">
      <documentation>Hugo – Flutter. Consome a API Java publicada no Render (login e cadastro JWT, token só na memória). Biometria simulada. O Termômetro do Dinheiro do painel é calculado no app (gastos ÷ entradas); trilhas e jogos usam dados locais (a API .NET ainda não é consumida).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: 5 jogos educativos" id="id-17c91046ec604b37af14acd8dabba215">
      <documentation>Preciso ou Quero, Mercado com Orçamento, Parcelas e Juros, Cofrinho de Metas e Mito ou Verdade.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: 6 vídeos educativos" id="id-07509ce2ee454497a84e49326e8999d9"/>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: Leitura em voz e letras grandes" id="id-2f3948ef27494772946071bbefced3a9">
      <documentation>flutter_tts e ajuste do tamanho da letra.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: Chat de WhatsApp simulado" id="id-a9108127c9d4436d845f22d1e6d6cd6e">
      <documentation>Frases como 'gastei 30 no mercado' viram lançamentos; o chatbot real é visão de produto.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="INTERFACE: Telas do app (7 telas acessíveis)" id="id-b8135ba54f194844946a286b6518fb11">
      <documentation>Início, Jogo, Login/Cadastro, Painel, Adicionar gasto, Plano de quitação, Alertas e energia.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="COMP: Chatbot WhatsApp (visão de produto)" id="id-ef9e69870a7a49b58bf6ba8de530cd81">
      <documentation>Fora do escopo das disciplinas; representado como evolução do produto.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: Extrair valor e categoria da mensagem" id="id-98f6f86699bf4de1a4887905e5889c64"/>
    <element xsi:type="archimate:ApplicationInterface" name="INTERFACE: Conversa no WhatsApp" id="id-a6639864286148ba840e896abaa93a96"/>
    <element xsi:type="archimate:ApplicationComponent" name="COMP: API Principal (Java 25 · Spring Boot 4.1)" id="id-f8750c699ced456aa2b9ed9627f3e834">
      <documentation>Pedro – Java Advanced. Spring Web, Data JPA, Bean Validation, Security + JWT, Caffeine, HATEOAS, Actuator, Swagger. Local: H2 em arquivo. Docker/Render: perfil oracle. Inclui exclusão da própria conta (DELETE /api/v1/usuarios/me).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: Autenticação JWT + BCrypt (USER/ADMIN)" id="id-e2806a48aa294eeeadc4028ffaa45ec2"/>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: CRUD de transações, categorias e dívidas" id="id-af9269b2017e449fbd4e79bf1b308083"/>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: Resumo mensal com cache (Caffeine)" id="id-c0d562157a4b4b7b8721a72e938b00ae"/>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: Termômetro de dívidas, plano e alertas" id="id-90f546c84fc84c448305b82412e31d54"/>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: Simuladores de juros e poupança" id="id-18334da8e27c44e5b585235dc98a2a47"/>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: Receber leituras do medidor" id="id-8253238cd092458d804d8897c0f32872">
      <documentation>POST /api/v1/dispositivos/{id}/leituras.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: HATEOAS, validação e erros padronizados" id="id-b733391acfb7407590108bca2cbbd16c"/>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: Actuator e Swagger/OpenAPI" id="id-b5a6eb45c6ce4091a4326ef29cd5f23f"/>
    <element xsi:type="archimate:ApplicationInterface" name="INTERFACE: REST API /api/v1 (JSON + JWT)" id="id-2d394a2fef61459b9934c00e9ada173c"/>
    <element xsi:type="archimate:ApplicationComponent" name="COMP: API de Conteúdo (C# / EF Core)" id="id-cd0fe53e7b65424095f05a477f693b42">
      <documentation>Matheus – ASP.NET Core 8 Web API em C#, EF Core com Oracle. Trilha 1:N Desafio, Migrations versionadas.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: CRUD de trilhas e desafios (EF Core)" id="id-ed904ebf1c9f4b1eb6a3fd80cbd65492"/>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: Respostas 400 / 404 em JSON" id="id-31b10850ac154f6b897aa9f21fc19e1b"/>
    <element xsi:type="archimate:ApplicationInterface" name="INTERFACE: REST API /api/trilhas" id="id-c512169ca4a645a1a8648f40ea961c44"/>
    <element xsi:type="archimate:ApplicationComponent" name="COMP: Rotinas PL/SQL (Oracle)" id="id-a0f27355c3ae4a529e321dd5c87519b2">
      <documentation>Davi – Banco. Procedures de operação e de consulta; o Termômetro do Dinheiro, o plano de quitação (WHILE mês a mês) e a prioridade das dívidas (cursor explícito por maior juros) ficam em blocos anônimos.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationProcess" name="PROC: prc_registrar_transacao" id="id-89052b54537a4288a81e5dc1afe49570"/>
    <element xsi:type="archimate:ApplicationProcess" name="PROC: prc_registrar_leitura_energia" id="id-34ad70dc35a340a0abb78399879cf784"/>
    <element xsi:type="archimate:ApplicationProcess" name="PROC: prc_resumo_energia" id="id-7d29639a4c074a21b984eb0950eb6986"/>
    <element xsi:type="archimate:ApplicationProcess" name="PROC: prc_alertas_vencimento" id="id-917fc58ea61a4d90b9d11a8e24b1377c"/>
    <element xsi:type="archimate:ApplicationComponent" name="COMP: Integração IoT (Node-RED)" id="id-2bdd9154c4824bb7ac2b181b830d206c">
      <documentation>Valida as leituras, agrega uma por minuto, grava CSV, faz login na API Java com a conta da família e publica ajustes de meta, tarifa e tensão para o medidor (tópico config).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: Ponte MQTT → HTTP" id="id-b151eb6377004498ab474185bc8e50f6"/>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: Dashboard de consumo" id="id-d6b7db6741ee45f9ad1771d2e55d20a1"/>
    <element xsi:type="archimate:ApplicationInterface" name="INTERFACE: Dashboard de energia" id="id-6774d46f3202486884a0db559eedfb99"/>
    <element xsi:type="archimate:ApplicationComponent" name="COMP: Firmware do medidor (ESP32 / Arduino)" id="id-5c7997318a2c462290414f21d9d2d72e">
      <documentation>Irms × tensão = W; W × tempo = kWh; kWh × tarifa = R$; LED/buzzer conforme a meta. Demonstração no Wokwi (corrente simulada com potenciômetro).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: Calcular W, kWh e R$ (EmonLib)" id="id-a5ad4e21de2f45e384f388bd7541794f"/>
    <element xsi:type="archimate:ApplicationFunction" name="FUNC: Guardar leituras offline e publicar" id="id-77af65bec8354ce2914549d6ade454d9"/>
    <element xsi:type="archimate:ApplicationInterface" name="INTERFACE: Tópicos MQTT da casa" id="id-2219407980db4c5d95bbcaf4c00bf98d">
      <documentation>granaamiga/casa/{id}/energia, alerta, status (Last Will), fechamento, config e config/ack.</documentation>
    </element>
