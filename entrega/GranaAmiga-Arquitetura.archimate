    <element xsi:type="archimate:Artifact" name="ARTIFACT: Migrations EF Core" id="id-6645653162164825b6411d0e3e4e9fec"/>
    <element xsi:type="archimate:SystemSoftware" name="SW: Oracle Database" id="id-1cb54d50e3f14c539f32761744f77185"/>
    <element xsi:type="archimate:Node" name="NODE: Execução local (dotnet run)" id="id-2e83f7baf91c4942bb0e036c3fc44ae7">
      <documentation>A API de Conteúdo roda localmente na máquina do desenvolvedor (dotnet run, servidor Kestrel embutido do ASP.NET Core 8), conectada ao Oracle da FIAP. A disciplina de .NET não exige deploy em nuvem.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="NODE: WhatsApp Business Platform (Meta)" id="id-c783dffc66d149d9b9cbbf568f743580">
      <documentation>Visão de produto.</documentation>
    </element>
    <element xsi:type="archimate:CommunicationNetwork" name="NET: Internet / rede móvel Claro (zero-rating)" id="id-32201647966f406e962c7e898637b0fe"/>
    <element xsi:type="archimate:CommunicationNetwork" name="NET: Wi-Fi doméstico" id="id-5cde148ee05a4ca58ab16f3caa388b7c"/>
    <element xsi:type="archimate:CommunicationNetwork" name="NET: Azure VNet + NSG (libera 22 e 8080)" id="id-299422ab499a46b7be5d5a0dca20ab59"/>
    <element xsi:type="archimate:CommunicationNetwork" name="NET: Internet" id="id-52e25a3477c848f09c66bae7bb8538c6"/>
  </folder>
  <folder name="Motivation" id="id-727deed15b264b43ba56695243aa89ec" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="STAKEHOLDER: Famílias endividadas (renda até 3 salários mínimos)" id="id-ccb9f47bfb1f46c48199be6021cac5a9">
      <documentation>Público principal: chefes de família de baixa renda, muitas vezes com baixa escolaridade.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="STAKEHOLDER: Prefeituras e CRAS" id="id-dd836e7427464f14990405c2d825bdda">
      <documentation>Assistência social municipal; usa a solução em programas sociais (modelo B2G).</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="STAKEHOLDER: Cooperativas de crédito e ONGs" id="id-2601fb6eb56c4c208f2274fbcf062b58">
      <documentation>Patrocinam trilhas educativas e oferecem renegociação justa de dívidas.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="STAKEHOLDER: Claro e distribuidoras de energia" id="id-bda5430a730740b39d5591aaa5981ef7">
      <documentation>Claro (parceira da GS) com zero-rating; distribuidoras/programas de eficiência energética distribuem o medidor.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="DRIVER: Endividamento recorde das famílias brasileiras" id="id-46d5ac3e5f89460a821c580f3cfe0b08">
      <documentation>Peic/CNC jul/2026: 82% das famílias com dívidas, recorde da série histórica.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="DRIVER: Baixa educação financeira e falta de ferramentas acessíveis" id="id-3aa6ed4e544244e890dce251b7186c66">
      <documentation>Apps financeiros pressupõem conta digital, leitura fluente e internet boa.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="DRIVER: Conta de luz pesa no orçamento e o consumo é invisível" id="id-c23b1f9ce66f4ffeb352f9b090813f50">
      <documentation>A família só descobre quanto gastou de energia quando a conta chega.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="ASSESS: 82% das famílias têm dívidas (Peic/CNC, jul/2026)" id="id-8b97a3b1c1f545fba5b4d48ccada0b3a">
      <documentation>Recorde da série histórica da CNC.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="ASSESS: 84,9% entre famílias com renda até 3 salários mínimos" id="id-87426aeb14b3439e8ff3ddb14ef5ceef">
      <documentation>Contra 72% acima de 10 salários mínimos.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="ASSESS: Cartão de crédito em 85,3% das famílias endividadas (Peic, jul/2026)" id="id-934ba97237c841bab3618c8c669c0d29">
      <documentation>Rotativo e parcelamento são o principal vilão.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="ASSESS: Comprometimento médio de ~30% da renda com dívidas" id="id-72132f953b4f482bbdd633c351280516">
      <documentation>Base do limite Verde do Termômetro do Dinheiro.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="ASSESS: Linguagem financeira difícil exclui quem tem baixa escolaridade" id="id-f1b7836de0874e7ebc7c83997ef24453"/>
    <element xsi:type="archimate:Assessment" name="ASSESS: Faltam ferramentas gratuitas, com áudio e que funcionem offline" id="id-5f9c3509460e4eb7ab13cee9d670bf3c"/>
    <element xsi:type="archimate:Assessment" name="ASSESS: Consumo de energia só aparece quando a conta chega" id="id-c47ea2df3988490391c98c49f2d4d6b0"/>
    <element xsi:type="archimate:Assessment" name="ASSESS: Feedback de consumo reduz de 4% a 12% o gasto de energia (ACEEE, 2010)" id="id-bcca620d7592459499a75eacf591689e">
      <documentation>Ehrhardt-Martinez, Donnelly e Laitner, ACEEE Report E105 (2010): meta-análise de programas de feedback residencial; feedback em tempo real fica no topo da faixa (~12%).</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="GOAL: Tirar famílias da faixa Vermelha do Termômetro do Dinheiro" id="id-2fec92451cbb4e2a8ee51edff1ad36ee"/>
    <element xsi:type="archimate:Goal" name="GOAL: Educar financeiramente de forma lúdica, inclusiva e gratuita" id="id-1897c7e912cb4a52818d4c4362d83ba7"/>
    <element xsi:type="archimate:Goal" name="GOAL: Reduzir o desperdício de energia e o peso da conta de luz" id="id-f3e173e0958d4ea29becf0bb22871b85"/>
    <element xsi:type="archimate:Outcome" name="OUTCOME: Meta – 30% dos usuários ativos saem do Vermelho em 3 meses" id="id-b3d7f61a9a5c4de8ad6304562345ec02">
      <documentation>Principal métrica de impacto.</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="OUTCOME: Valor total de dívidas quitadas cresce mês a mês" id="id-0411586e6a5a461eb8d39f0874ef3347"/>
    <element xsi:type="archimate:Outcome" name="OUTCOME: Trilhas concluídas e dias seguidos registrando gastos" id="id-2356a996e95442778ad78390122e5070"/>
    <element xsi:type="archimate:Outcome" name="OUTCOME: Meta – 20% dos visitantes da área aberta criam conta" id="id-034ff2bad44b480bb45885b92864399a">
      <documentation>Conversão da área aberta (jogos) em uso do painel.</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="OUTCOME: Meta – 10% a menos de consumo nas casas com medidor" id="id-301d95620b1b4aeb810e4f0cb0739032">
      <documentation>Dentro da faixa de 4–12% da ACEEE; o medidor dá feedback em tempo real, tipo de programa no topo da faixa.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ: Login por telefone + senha (JWT) e biometria do aparelho" id="id-614c3d8aec0c4e799023d01617b2ab1b">
      <documentation>Biometria só destrava o token salvo; voz apenas para navegação.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ: Painel agregado e anonimizado para CRAS e parceiros" id="id-5f72a9984d594850ba87714c43d2e664">
      <documentation>Modelo B2G que sustenta a gratuidade.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ: Termômetro – Verde ≤ 30%, Amarelo ≤ 50%, Vermelho &gt; 50% da renda" id="id-74497b324b65455dbc0f608f364786ef">
      <documentation>comprometimento = soma das parcelas ativas / renda mensal.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ: Plano de quitação (maior juros primeiro) com alertas de vencimento" id="id-97c923d07cb14dc9a7ffc99b6d3b5503">
      <documentation>Método avalanche.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ: Registrar gastos por ícones, voz ou WhatsApp" id="id-42c58e69f3434e8e9477a47e50279e39"/>
    <element xsi:type="archimate:Requirement" name="REQ: Trilhas e desafios gerenciáveis sem novo deploy do app" id="id-b3ae2fca97a342b4bd2064ce12d1154a"/>
    <element xsi:type="archimate:Requirement" name="REQ: Área aberta com jogos sem cadastro, com áudio e ícones grandes" id="id-07cedbf244d2486ca1dcf330dec81ab6"/>
    <element xsi:type="archimate:Requirement" name="REQ: Medidor mostra a luz em R$ e alerta antes de estourar a meta" id="id-7accaa4bd8eb4b85b48bf96c697031c8">
      <documentation>LED verde &lt; 70%, amarelo 70–100%, vermelho &gt; 100% + buzzer.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ: Registro offline com sincronização posterior" id="id-ad7f0fc2b91a487eb992331408583999"/>
    <element xsi:type="archimate:Constraint" name="CONST: LGPD – dados financeiros e de consumo são dados pessoais" id="id-4206fced084e48eba3c99faeb8901ca5"/>
    <element xsi:type="archimate:Principle" name="PRINCIPLE: Privacidade desde a concepção (LGPD)" id="id-54b9720440c74b378df6deeb0bfce4b7">
      <documentation>Telefone no lugar de CPF; dados agregados e anonimizados para parceiros.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="PRINCIPLE: Gratuito para as famílias" id="id-0439752cdf9943a5aee391371d2a453e">
      <documentation>Sustentado por B2G e parcerias.</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="CONST: Escopo da GS – chatbot e IA de voz ficam como visão de produto" id="id-655a3ac9332b40bdb50a39c609375287">
      <documentation>Não são cobrados por nenhuma disciplina; no app há uma tela simulada / link wa.me.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="PRINCIPLE: Cidadão no centro – simples, inclusivo e acessível" id="id-482adf1806f6412fa4ef595092c2a15f">
      <documentation>Áudio, ícones grandes, linguagem simples.</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="CONST: Baixa escolaridade e pouca familiaridade digital" id="id-a7b8fcc5478c4aac8018ed13c260f04a"/>
    <element xsi:type="archimate:Constraint" name="CONST: Medidor barato e não invasivo (sensor de alicate SCT-013)" id="id-98d5c0e96e6a48d584ff19f379ba339a">
      <documentation>Segurança elétrica: nada em série com a rede 127/220 V.</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="CONST: Conectividade limitada e pacote de dados restrito" id="id-5024baa79e4840b992d25de13a82dae9"/>
    <element xsi:type="archimate:Principle" name="PRINCIPLE: Funciona fora do cenário ideal (offline-first)" id="id-4ff2b9ee18ff49d399f6fc03ea7b144d">
      <documentation>Conectividade ruim não pode impedir o uso.</documentation>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-c9e7149fc8ed4b75a43fa74f894bb203" type="implementation_migration"/>
  <folder name="Other" id="id-136f68f141264b21b52beeabc929c4a6" type="other">
    <element xsi:type="archimate:Grouping" name="CAMADA DE MOTIVAÇÃO  ·  Fase A – Visão de Arquitetura" id="id-3bbd1dd9dd674d82a761b15e8f3b902a">
      <documentation>Por que a solução existe: interessados, direcionadores, avaliações (dados de mercado), objetivos, resultados esperados, princípios, requisitos e restrições.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="CAMADA DE NEGÓCIO  ·  Fase B – Arquitetura de Negócio" id="id-10e49a3984544206b463cfd9b4d47f62">
      <documentation>Quem participa do ecossistema, quais serviços de negócio a solução oferece, quais processos os realizam e quais informações de negócio são usadas.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Aprender jogando (área aberta)" id="id-a75125eb3c05422799fa3951bf7ee5e5"/>
    <element xsi:type="archimate:Grouping" name="Jornada financeira da família" id="id-27601d3b7f69418cb7859afd4f24f804"/>
    <element xsi:type="archimate:Grouping" name="Energia da casa" id="id-a40115a8468e4fcc890029747baa856d"/>
    <element xsi:type="archimate:Grouping" name="CAMADA DE APLICAÇÃO  ·  Fase C – Arquitetura de Sistemas (aplicações e dados)" id="id-3b10ead75a984857a200ae09d2b75818">
      <documentation>Componentes de software, serviços de aplicação, interfaces e objetos de dados que realizam os serviços de negócio.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="CAMADA DE TECNOLOGIA  ·  Fase D – Arquitetura de Tecnologia" id="id-386182990e45459caadc0b9268811963">
      <documentation>Dispositivos, nós, software de sistema, redes e artefatos que executam e conectam as aplicações.</documentation>
    </element>
  </folder>
